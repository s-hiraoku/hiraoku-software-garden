name: Garden Verify

on:
  pull_request:
    types: [opened, synchronize]
  issue_comment:
    types: [created]
  workflow_dispatch:
    inputs:
      flow:
        description: "Flow name to run"
        required: true
        default: "verify_only"
        type: string

permissions:
  contents: read
  issues: write
  pull-requests: write

jobs:
  garden:
    if: >-
      github.event_name != 'issue_comment' ||
      startsWith(github.event.comment.body, '/garden resume')
    uses: s-hiraoku/hiraoku-software-garden/.github/workflows/garden-reusable.yml@main
    with:
      flow: ${{ inputs.flow || 'verify_only' }}
      issue_number: ${{ github.event.pull_request.number || github.event.issue.number || 0 }}
